	(text "X6 RESOLVED: QUALIFIED IGNITION, A5 DOMAIN  -  CUTOFF_MARGIN_REVIEW S2"
		(exclude_from_sim no)
		(at 20.32 586.27 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
