# Copy outside the checkout; restrict permissions to the service administrator.
ACCORD_UPLOAD_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN
ACCORD_STATE_DIR=/var/lib/accord-receiver
ACCORD_BIND=127.0.0.1
ACCORD_PORT=8086
ACCORD_TZ=America/Los_Angeles
# Set ACCORD_BIND to a reachable interface for Pico uploads on a trusted LAN.
